# Rebourn Vault MCP configuration. scripts/deploy.sh sets all of these on
# Railway for you; this file documents them for manual setups.

# Relay.md backend (hosted Relay.md values; change only for self-hosted Relay)
RELAY_API_URL=https://api.system3.md
PB_AUTH_URL=https://auth.system3.md
PB_COLLECTION=users

# Public URL of THIS server (OAuth issuer). On Railway you can leave it unset
# and RAILWAY_PUBLIC_DOMAIN is used; set it explicitly for custom domains.
PUBLIC_URL=

# Secrets. Generate with: bash scripts/gen-secrets.sh
JWT_SECRET=                         # >= 32 chars; rotating it signs everyone out
STATIC_MCP_BEARER=                  # optional; long-lived token for scripts that skip OAuth

# Who may sign in (comma-separated Relay.md account emails). Empty = anyone
# with a Relay.md account. Always set this for client deployments.
ALLOWED_EMAILS=

# Optional: pin a specific Relay vault (GUID from vault_relays). Empty = the
# first relay the signed-in user can access.
RELAY_ID=

# Only used together with STATIC_MCP_BEARER: the PocketBase token used for
# upstream Relay.md calls when a script authenticates with the static bearer.
RELAY_AUTH_TOKEN=

# Storage for sessions.enc, clients.json, pending.json (mount a volume here)
DATA_DIR=/data
PORT=3000
